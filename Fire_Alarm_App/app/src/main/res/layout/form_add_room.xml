<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F6F6"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/addRoomTitleDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Add New Room"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Name -->
    <TextView
        android:id="@+id/txtRoomName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/addRoomTitleDialog"
        android:text="Name room *"
        android:textColor="#818181"
        android:layout_marginTop="20dp"/>

    <EditText
        android:id="@+id/edtRoomName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txtRoomName"
        android:layout_marginTop="2dp"
        android:background="@drawable/back"
        android:hint="Name room"
        android:inputType="textPersonName"
        android:minHeight="48dp"
        android:paddingStart="10dp"
        android:textSize="16sp" />

    <!-- Address -->
    <TextView
        android:id="@+id/txtRoomPosition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/edtRoomName"
        android:text="Position room *"
        android:textColor="#818181"
        android:layout_marginTop="20dp"/>

    <EditText
        android:id="@+id/edtRoomPosition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txtRoomPosition"
        android:layout_marginTop="2dp"
        android:background="@drawable/back"
        android:hint="Position room"
        android:inputType="textPersonName"
        android:minHeight="48dp"
        android:paddingStart="10dp"
        android:textSize="16sp" />


    <TextView
        android:id="@+id/txtRoomArea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_below="@+id/edtRoomPosition"
        android:text="Area (m2)" />

    <EditText
        android:id="@+id/edtRoomArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txtRoomArea"
        android:layout_marginTop="2dp"
        android:background="@drawable/back"
        android:hint="Area room"
        android:inputType="number"
        android:minHeight="48dp"
        android:paddingStart="10dp"
        android:textSize="16sp" />

        <!-- Owner -->

    <TextView
        android:id="@+id/txtRoomOwner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_below="@+id/edtRoomArea"
        android:text="Owner" />

    <EditText
        android:id="@+id/edtRoomOwner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/back"
        android:hint="Owner room"
        android:inputType="textPersonName"
        android:minHeight="48dp"
        android:layout_below="@+id/txtRoomOwner"
        android:paddingStart="10dp"
        android:textSize="16sp" />


    <!-- Notification -->
    <TextView
        android:id="@+id/txtNotificationRoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_centerHorizontal="true"
        android:textColor="@color/red"
        android:textStyle="bold"
        android:textSize="15dp"
        android:visibility="gone"
        android:layout_below="@+id/edtRoomOwner"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@+id/edtRoomOwner"
        android:layout_marginTop="30dp">
        <Button
            android:id="@+id/btnCreateNewRoom"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:layout_marginStart="15dp"
            android:backgroundTint="@color/design_default_color_secondary"
            android:text="Create" />

        <Button
            android:id="@+id/btnCancelAddNewRoom"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="55dp"
            android:minHeight="60dp"
            android:backgroundTint="@color/red"
            android:text="Cancel" />
    </LinearLayout>
</RelativeLayout>