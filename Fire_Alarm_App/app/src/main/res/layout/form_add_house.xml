<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F6F6"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/addHouseTitleDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Add New House"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Name -->
    <TextView
        android:id="@+id/txtHouseName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/addHouseTitleDialog"
        android:text="Name house *"
        android:textColor="#818181"
        android:layout_marginTop="20dp"/>

    <EditText
        android:id="@+id/edtHouseName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txtHouseName"
        android:layout_marginTop="2dp"
        android:background="@drawable/back"
        android:hint="Name house"
        android:inputType="textPersonName"
        android:minHeight="48dp"
        android:paddingStart="10dp"
        android:textSize="16sp" />

    <!-- Address -->
    <TextView
        android:id="@+id/txtHouseAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/edtHouseName"
        android:text="Address house *"
        android:textColor="#818181"
        android:layout_marginTop="20dp"/>

    <EditText
        android:id="@+id/edtHouseAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txtHouseAddress"
        android:layout_marginTop="2dp"
        android:background="@drawable/back"
        android:hint="Address house"
        android:inputType="textPersonName"
        android:minHeight="48dp"
        android:paddingStart="10dp"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/linear_area_floor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/edtHouseAddress"
        android:orientation="horizontal">

        <!-- Area -->
        <LinearLayout
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtHouseArea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Area (m2)" />

            <EditText
                android:id="@+id/edtHouseArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/back"
                android:hint="House area"
                android:inputType="number"
                android:minHeight="48dp"
                android:paddingStart="10dp"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Floor -->
        <LinearLayout
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="35dp">

            <TextView
                android:id="@+id/txtHouseFloor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Floor" />

            <EditText
                android:id="@+id/edtHouseFloor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/back"
                android:hint="House floor"
                android:inputType="number"
                android:minHeight="48dp"
                android:paddingStart="10dp"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Members -->
    <TextView
        android:id="@+id/txtHouseMembers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_below="@+id/linear_area_floor"
        android:text="Number of members" />

    <EditText
        android:id="@+id/edtHouseMembers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txtHouseMembers"
        android:layout_marginTop="2dp"
        android:background="@drawable/back"
        android:hint="Number of members"
        android:inputType="number"
        android:minHeight="48dp"
        android:paddingStart="10dp"
        android:textSize="16sp" />

    <!-- Notification -->
    <TextView
        android:id="@+id/txtNotificationHouse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_centerHorizontal="true"
        android:textColor="@color/red"
        android:textStyle="bold"
        android:textSize="15dp"
        android:visibility="gone"
        android:layout_below="@+id/edtHouseMembers"
         />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@+id/edtHouseMembers"
        android:layout_marginTop="30dp">
        <Button
            android:id="@+id/btnAddNewHouse"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:layout_marginStart="15dp"
            android:backgroundTint="@color/design_default_color_secondary"
            android:text="Create" />

        <Button
            android:id="@+id/btnCancelAddNewHouse"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="55dp"
            android:minHeight="60dp"
            android:backgroundTint="@color/red"
            android:text="Cancel" />
    </LinearLayout>
</RelativeLayout>